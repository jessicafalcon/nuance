# Copy to `.env` (gitignored) and fill in. Commands that call a live service load it
# with `uv run --env-file .env objection-brief ...`; no code reads this file itself.

# Anthropic API key for detection and the follow-up draft. Use a key made for this
# project, in a workspace with a monthly spend limit.
ANTHROPIC_API_KEY=

# Optional. Slack incoming webhook for an internal channel. Unset: briefs are written
# to out/briefs/ and previewed in the terminal instead. Treat the URL as a secret.
SLACK_WEBHOOK_URL=
